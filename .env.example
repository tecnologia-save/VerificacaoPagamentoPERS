# MODELO — copie para `.env` (na mesma pasta do run.py) e preencha lá.
# NUNCA coloque valores reais NESTE arquivo.

# Chave da API do Google Gemini, usada pelo solver de hCaptcha durante o login
# no e-CAC (o ecac_login lê este .env). É a mesma chave das Protocolações.
GEMINI_API_KEY=sua_chave_gemini_aqui

# Não há certificado aqui: cada linha usa o .pfx do procurador (coluna B) em
# C:\Certificados, com a senha de C:\Certificados\senhas.json.
